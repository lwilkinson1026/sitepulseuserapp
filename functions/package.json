{
  "name": "sitepulse-functions",
  "description": "SitePulse Cloud Functions — event-triggered push fan-out and (later) claim flows.",
  "private": true,
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "lint": "tsc --noEmit",
    "serve": "npm run build && firebase emulators:start --only functions",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "20"
  },
  "main": "lib/index.js",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "expo-server-sdk": "^3.10.0",
    "firebase-admin": "^13.0.0",
    "firebase-functions": "^6.0.0",
    "stripe": "^22.6.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "typescript": "~5.9.2"
  }
}
