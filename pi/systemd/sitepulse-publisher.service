[Unit]
Description=SitePulse Firebase publisher (Predator I²C + VESC CAN → Firestore)
After=network-online.target sitepulse-can.service
Wants=network-online.target sitepulse-can.service
# Publisher sniffs the Predator's BMS↔LCD I²C bus on GPIO 22/23 AND listens
# to the VESC motor controller on can0. Wants= (not Requires=) the CAN
# service so the publisher still boots if can0 is misconfigured — the VESC
# listener logs a warning and the Predator pipeline runs normally.
# I²C is bit-banged on GPIO 22/23, intentionally NOT the kernel's i2c-1 bus
# on GPIO 2/3 (reserved for the PCA9685 servo driver).

[Service]
Type=simple

# Identical on every unit in the fleet. Everything that differs between units
# lives in /etc/sitepulse/unit.env, so this file ships verbatim everywhere.
User=sitepulse
Group=sitepulse
# The service user is deliberately NOT in sudo. It needs exactly these groups:
#   gpio    — bit-banged Predator I²C on GPIO 22/23, relay HAT, override pin
#   i2c     — /dev/i2c-1 for the PCA9685 servo driver
#   spi     — MCP2515 CAN HAT
#   video   — /dev/video0 for sentry + streamer
#   dialout — serial, if a VESC UART fallback is ever wired
SupplementaryGroups=gpio i2c spi video dialout
WorkingDirectory=/opt/sitepulse/current

# ── Fleet-wide defaults ───────────────────────────────────────────────────
# systemd applies Environment= and EnvironmentFile= in the order they appear,
# and a later assignment wins. The EnvironmentFile= below therefore overrides
# anything set here, which is what makes per-unit overrides work.
Environment=SITEPULSE_SA=/etc/sitepulse/service-account.json
Environment=SITEPULSE_PREDATOR_SDA_PIN=22
Environment=SITEPULSE_PREDATOR_SCL_PIN=23
Environment=SITEPULSE_PREDATOR_ADDR=0x3E
Environment=SITEPULSE_INTERVAL=15
# Publish the raw 18-byte hex frame on every snapshot. Useful for ongoing
# decoder development (SoC mapping, mode bits, fault icons). Remove once the
# decoder is feature-complete to save bytes.
Environment=SITEPULSE_PREDATOR_PUBLISH_RAW=1

# ── Per-unit config ───────────────────────────────────────────────────────
# Intentionally NOT prefixed with '-', so a missing file fails the unit loudly
# rather than starting. SITEPULSE_UNIT_ID defaults to "UNIT-001" in the Python,
# which means a unit that silently lost this file would publish into another
# unit's Firestore documents. Refusing to start is the far better outcome.
EnvironmentFile=/etc/sitepulse/unit.env

ExecStart=/usr/bin/python3 -u /opt/sitepulse/current/firebase_publisher.py
Restart=on-failure
RestartSec=5

StandardOutput=append:/var/log/sitepulse/publisher.log
StandardError=inherit

# Safe on this workload: the service never escalates privileges, and sentry
# writes clips through tempfile before uploading, so a private /tmp is
# transparent to it.
NoNewPrivileges=yes
PrivateTmp=yes
# Deliberately NOT set: PrivateDevices=yes (breaks GPIO/I²C/SPI outright) and
# ProtectSystem=strict (plausible here, but unverified against the hardware —
# enable it only after watching a real unit come up clean).

[Install]
WantedBy=multi-user.target
