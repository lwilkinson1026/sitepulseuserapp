[Unit]
Description=SitePulse Firebase publisher (Predator I²C + VESC CAN → Firestore)
After=network-online.target sitepulse-can.service
Wants=network-online.target sitepulse-can.service
# Publisher sniffs the Predator's BMS↔LCD I²C bus on GPIO 22/23 AND listens
# to the VESC motor controller on can0. Wants= (not Requires=) the CAN
# service so the publisher still boots if can0 is misconfigured — the VESC
# listener logs a warning and the Predator pipeline runs normally.
# I²C is bit-banged on GPIO 22/23, intentionally NOT the kernel's i2c-1 bus
# on GPIO 2/3 (reserved for the PCA9685 servo driver).

[Service]
Type=simple
User=lwilkinson
WorkingDirectory=/home/lwilkinson/sitepulse
Environment=SITEPULSE_SA=/home/lwilkinson/sitepulse/service-account.json
# Override the defaults below by editing /etc/default/sitepulse-publisher
# or by writing a drop-in:
#   sudo systemctl edit sitepulse-publisher.service
# Defaults baked into the Python module itself if these are unset.
Environment=SITEPULSE_PREDATOR_SDA_PIN=22
Environment=SITEPULSE_PREDATOR_SCL_PIN=23
Environment=SITEPULSE_PREDATOR_ADDR=0x3E
Environment=SITEPULSE_INTERVAL=3
# Publish the raw 18-byte hex frame on every snapshot.  Useful for
# ongoing decoder development (SoC mapping, mode bits, fault icons).
# Remove this line once the decoder is feature-complete to save bytes.
Environment=SITEPULSE_PREDATOR_PUBLISH_RAW=1
ExecStart=/usr/bin/python3 -u /home/lwilkinson/sitepulse/firebase_publisher.py
Restart=on-failure
RestartSec=5
# Preserve the existing log file workflow — same paths the manual
# nohup commands wrote to, so `tail -f publisher.log` keeps working.
StandardOutput=append:/home/lwilkinson/sitepulse/publisher.log
StandardError=inherit

[Install]
WantedBy=multi-user.target
