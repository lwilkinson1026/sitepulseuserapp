# SitePulse per-unit configuration  →  install as /etc/sitepulse/unit.env
#
# This is the ONLY file that differs between units. The three systemd units
# are byte-identical across the fleet; everything unit-specific lives here.
# Copy it, fill in the values, and keep it out of git.
#
# Read by systemd, NOT by a shell: no `export`, no $VAR expansion, no command
# substitution, no inline `#` comments after a value. One KEY=value per line.
# Values with spaces need double quotes.
#
#   sudo install -d -m 0750 -o root -g sitepulse /etc/sitepulse
#   sudo install -m 0640 -o root -g sitepulse unit.env.example /etc/sitepulse/unit.env
#   sudo nano /etc/sitepulse/unit.env
#   sudo systemctl restart sitepulse-publisher sitepulse-listener

# ── Required ──────────────────────────────────────────────────────────────

# Which Firestore documents this Pi owns: units/<SITEPULSE_UNIT_ID>/...
# The Python default is "UNIT-001". If this file goes missing the services
# refuse to start rather than silently adopting that default and stomping on
# another unit's data — see the EnvironmentFile= note in the unit files.
#
# Left as an obviously-invalid placeholder on purpose. provision_unit.sh
# rewrites it; if you are copying this file by hand and forget, the unit
# shows up as a junk document rather than quietly colliding with a real one.
SITEPULSE_UNIT_ID=CHANGEME

# VESC controller ID to filter CAN frames for, and to address when cranking.
# MUST be set explicitly. The Python default is 0, but every VESC we have
# flashed is configured as 100 — a unit missing this line looks like a dead
# CAN bus (frames arrive, none match the filter, telemetry is silently empty).
SITEPULSE_VESC_UNIT_ID=100

# ── Cloudflare Stream (per-unit live input) ───────────────────────────────
# Each unit has its own live input, so these are genuinely per-unit secrets.
# streamer.py defaults both to "" and refuses to start the stream if unset.
# The HLS URL must NOT carry ?protocol=llhlsbeta — iOS will not play it.
SITEPULSE_CLOUDFLARE_RTMP_TARGET=
SITEPULSE_CLOUDFLARE_HLS_URL=

# ── Optional overrides ────────────────────────────────────────────────────
# Uncomment only to deviate from the fleet defaults set in the unit files or
# baked into the Python. Listed here so the full surface is discoverable in
# one place rather than by grepping os.environ across pi/*.py.

# Predator I²C tap (bit-banged; NOT the kernel i2c-1 bus on GPIO 2/3)
#SITEPULSE_PREDATOR_SDA_PIN=22
#SITEPULSE_PREDATOR_SCL_PIN=23
#SITEPULSE_PREDATOR_ADDR=0x3E
#SITEPULSE_PREDATOR_GPIO_CHIP=4
#SITEPULSE_PREDATOR_PUBLISH_RAW=1

# Publisher cadence, seconds between Firestore snapshot writes
#SITEPULSE_INTERVAL=3

# VESC listener
#SITEPULSE_VESC_ENABLED=1
#SITEPULSE_VESC_IFACE=can0
#SITEPULSE_VESC_STALE_SEC=10
#SITEPULSE_VESC_DEBUG=0

# Relay HAT wiring. Set these wrong and the relays act inverted — verify
# against the physical board before changing.
#SITEPULSE_RELAY_ACTIVE_LOW=1
#SITEPULSE_RELAY_INVERT=

# Physical override switch
#SITEPULSE_OVERRIDE_PIN=

# Engine
#SITEPULSE_ENGINE_CURRENT=

# Scheduler / sentry
#SITEPULSE_SCHEDULER_INTERVAL=30
#SITEPULSE_SENTRY_COOLDOWN=60
#SITEPULSE_DEFAULT_TZ=America/New_York

# Camera + stream encoding
#SITEPULSE_CAMERA_DEVICE=/dev/video0
#SITEPULSE_CAMERA_W=1280
#SITEPULSE_CAMERA_H=720
#SITEPULSE_CAMERA_FPS=15
#SITEPULSE_STREAM_W=1280
#SITEPULSE_STREAM_H=720
#SITEPULSE_STREAM_FPS=15
#SITEPULSE_STREAM_BITRATE=2500k
#SITEPULSE_STREAM_ENCODER=
#SITEPULSE_STREAM_MAX_S=

# Verbose logging
#SITEPULSE_DEBUG=0
